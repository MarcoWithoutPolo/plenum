{
  "name": "plenum",
  "version": "1.0.0",
  "private": true,
  "description": "A desktop app that runs your AI coding CLIs (Claude Code, Codex, Antigravity, Copilot, Cursor and more) as one team: chat with any of them, ask them all at once, or let them build a project for days.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "plenum": "tsx --conditions=development apps/cli/src/main.ts",
    "typecheck": "tsc -b && npm run -s -w @plenum/desktop typecheck",
    "desktop": "npm run -w @plenum/desktop dev",
    "desktop:build": "npm run -w @plenum/desktop build",
    "e2e": "npm run desktop:build && npm run -w @plenum/desktop e2e",
    "ci:local": "tsx scripts/ci-local.ts",
    "record-fixture": "tsx --conditions=development apps/cli/src/record-fixture.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
